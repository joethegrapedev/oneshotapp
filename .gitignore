# ============================================================================
# One Shot — .gitignore (Flutter + Android + editors)
# ============================================================================

# ---- Secrets / signing (NEVER commit) --------------------------------------
.env
.env.*
!.env.example
android/key.properties
**/*.keystore
**/*.jks
android/app/upload-keystore.jks

# ---- Machine-specific ------------------------------------------------------
android/local.properties
local.properties
**/local.properties

# ---- Flutter / Dart --------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
flutter_*.png
generated_plugin_registrant.*
**/doc/api/
coverage/
.fvm/

# ---- Android ---------------------------------------------------------------
android/.gradle/
.gradle/
android/captures/
android/.cxx/
android/app/debug/
android/app/profile/
android/app/release/
android/gradle/wrapper/gradle-wrapper.jar
*.iml
*.class
*.apk
*.aab
*.ap_
*.dex

# ---- iOS (added when the iOS platform is generated later) ------------------
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Pods/
ios/.symlinks/
**/Flutter/App.framework/
**/Flutter/flutter_assets/
**/DerivedData/

# ---- Supabase --------------------------------------------------------------
supabase/.branches
supabase/.temp
supabase/.env

# ---- IntelliJ / Android Studio ---------------------------------------------
.idea/
*.ipr
*.iws
.idea/**/workspace.xml

# ---- VS Code ---------------------------------------------------------------
.vscode/
!.vscode/settings.json.example

# ---- OS junk ---------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
*.swp

# Node (legal-page generator in scripts/)
node_modules/
scripts/node_modules/
scripts/package-lock.json

# Local run configs (contain public keys but keep out of git)
dart_defines/

# Local upload-key credentials (never commit)
android/UPLOAD_KEYSTORE_CREDENTIALS.txt

# Built artifacts (AAB/APK) — never commit
dist/
*.aab
*.apk
