<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One Shot requests the INTERNET permission ONLY.
         NO sensitive permissions are requested: no contacts, no location,
         no external storage, no camera, no microphone. The app is a text
         journal that talks to Supabase over HTTPS; that is all it needs. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (Android 11+) for url_launcher. We only declare the
         intents we actually launch: phone dialer (crisis hotlines), email
         (support), and https web pages (Terms / Privacy). No broad queries. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="One Shot"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Displays the launch theme until Flutter's first frame is drawn. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Flutter Android embedding v2 marker. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
